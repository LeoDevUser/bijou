# Copy to .env and fill in. Load before running:
#   set -a; source .env; set +a; ./mvnw spring-boot:run

# ── Database (local Postgres) ─────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/bijou
DB_USERNAME=postgres
DB_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT_SECRET must be base64 and long enough for HS256 (32+ bytes decoded).
# Generate one with: openssl rand -base64 48
JWT_SECRET=
# Seeded on startup by AdminSeeder — this is how you log into the admin panel.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Secret path segment the admin routes live under (frontend needs the same value).
ADMIN_PAGE=admin
# Leave false for local http; true in production.
COOKIE_SECURE=false

# ── Stripe (test keys are fine locally) ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
# From: stripe listen --forward-to localhost:8080/public/webhook/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── Email (Brevo) ─────────────────────────────────────────────────────────────
BREVO_API_KEY=
MAIL_SENDER=you@yourdomain.com

# SMTP fallback — only needed if you turn the relay off in admin settings.
#MAIL_USERNAME=
#MAIL_PASSWORD=
